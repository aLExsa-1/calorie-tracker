<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 及以下的备份规则。
     allowBackup="false" 已关闭备份，这里再显式排除数据目录，
     防止个别系统或第三方工具仍尝试备份健康记录与明文 API Key。 -->
<full-backup-content>
    <exclude domain="file" path="data/" />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>

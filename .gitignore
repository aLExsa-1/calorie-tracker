# 构建工具链（约 2 GB，可随时用 .android-build 下的脚本重建）
# 注意：这里同时存放了 release keystore 与签名口令，绝对不要提交或分享。
.android-build/

# 同步产生的副本（源在项目根的 backend/ 与 frontend/，用 sync_app.py 重新生成）
android/app/src/main/python/backend/
android/app/src/main/python/frontend/
android/app/src/main/python/SYNC_MANIFEST.json

# Android 构建产物
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
*.apk
*.aab

# Python
__pycache__/
*.pyc
*.pyo

# 运行数据（含明文 API Key）
data/
_v1_local_rules/
tests/.data/
